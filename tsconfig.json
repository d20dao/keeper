{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "mocha"],
    "allowImportingTsExtensions": true
  },
  "include": ["hardhat.config.ts", "test/**/*.ts", "scripts/**/*.ts", "src/**/*.ts", "keeper/**/*.ts"]
}
